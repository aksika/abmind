{
  "name": "abmind",
  "version": "0.3.2-alpha.0",
  "description": "Standalone AI agent memory system — SQLite, FTS5, embeddings, 4-layer recall, sleep maintenance",
  "keywords": [
    "ai",
    "agent",
    "memory",
    "llm",
    "sqlite",
    "fts5",
    "embeddings",
    "recall",
    "sleep",
    "consolidation"
  ],
  "homepage": "https://github.com/aksika/abmind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksika/abmind.git"
  },
  "bugs": {
    "url": "https://github.com/aksika/abmind/issues"
  },
  "author": "aksika <aksikatwo@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./openclaw-plugin": {
      "types": "./dist/src/openclaw-plugin/index.d.ts",
      "default": "./dist/src/openclaw-plugin/index.js"
    },
    "./deploy-lib": {
      "types": "./dist/src/deploy-lib/index.d.ts",
      "default": "./dist/src/deploy-lib/index.js"
    },
    "./deploy-lib/*": {
      "types": "./dist/src/deploy-lib/*",
      "default": "./dist/src/deploy-lib/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SUPPORTED-SURFACE.md",
    "openclaw.plugin.json",
    "templates/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/version.mjs && rm -rf dist && tsc",
    "prepare": "node scripts/version.mjs && rm -rf dist && tsc",
    "test": "node scripts/version.mjs && vitest run --dir src",
    "test:watch": "node scripts/version.mjs && vitest --dir src",
    "typecheck": "node scripts/version.mjs && tsc --noEmit && node scripts/check-async-promises.mjs",
    "test:e2e": "npm run build && node dist/cli/abmind.js deps install && node dist/tests/acceptance/local-runner.js && node dist/tests/acceptance/consumer-controller-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.32.0",
    "typebox": "^1.1.38"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1",
    "eslint": "10.9.1",
    "fast-check": "^3.23.2",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/openclaw-plugin/index.js"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
