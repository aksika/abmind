{
  "_comment": "abmind hooks for Gemini CLI. Uses --format gemini for structured output injection. Requires: tools.enableHooks=true in ~/.gemini/settings.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "abmind hook-wakeup --format gemini",
            "timeout": 8000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "abmind hook-recall --format gemini",
            "timeout": 8000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "abmind hook-store",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
